{
  "project": {
    "tauriDir": "src-tauri",
    "frontendDir": "",
    "keysDir": "keys",
    "iconsDir": "icons",
    "productName": ""
  },
  "build": {
    "retry": 3,
    "concurrency": 4,
    "retryBaseDelay": 1000,
    "retryMaxDelay": 30000,
    "tuiStartRetries": 3,
    "tuiStartRetryDelayMs": 500,
    "tuiConnectTimeoutMs": 10000,
    "tuiExitFlushMs": 200,
    "summaryWidth": 50
  },
  "tui": {
    "host": "127.0.0.1",
    "refreshMs": 500,
    "exitDelayMs": 1500,
    "parentPollMs": 1000,
    "logLimit": 5000,
    "minCols": 70,
    "minRows": 16,
    "inputBufferLimit": 8192
  },
  "icons": {
    "platforms": {
      "desktop": {
        "source": ["icon-desktop.png", "icon.png"],
        "output": "src-tauri/icons"
      },
      "mac": {
        "source": ["icon-mac.png", "icon-desktop.png", "icon.png"],
        "output": "src-tauri/icons"
      },
      "win": {
        "source": ["icon-win.png", "icon-desktop.png", "icon.png"],
        "output": "src-tauri/icons"
      },
      "linux": {
        "source": ["icon-linux.png", "icon-desktop.png", "icon.png"],
        "output": "src-tauri/icons"
      },
      "android": {
        "source": ["icon-android.png", "icon.png"],
        "output": "src-tauri/gen/android/app/src/main/res"
      },
      "ios": {
        "source": ["icon-ios.png", "icon.png"],
        "output": "src-tauri/gen/apple/Assets.xcassets/AppIcon.appiconset"
      }
    },
    "tempDir": "icons/temp"
  },
  "ios": {
    "target": "device",
    "sign": true
  },
  "artifacts": {
    "output": "release",
    "platforms": {
      "win": {
        "dir": "win",
        "patterns": ["src-tauri/target/x86_64-pc-windows-gnu/release/bundle/nsis/*.exe"]
      },
      "win-arm64": {
        "dir": "win-arm64",
        "patterns": ["src-tauri/target/aarch64-pc-windows-msvc/release/bundle/nsis/*.exe"]
      },
      "win-portable": {
        "dir": "win-portable",
        "patterns": ["src-tauri/target/x86_64-pc-windows-msvc/release/{productName}.exe"]
      },
      "win-arm64-portable": {
        "dir": "win-arm64-portable",
        "patterns": ["src-tauri/target/aarch64-pc-windows-msvc/release/{productName}.exe"]
      },
      "linux": {
        "dir": "linux",
        "patterns": ["src-tauri/target/x86_64-unknown-linux-gnu/release/{productName}"]
      },
      "linux-arm64": {
        "dir": "linux-arm64",
        "patterns": ["src-tauri/target/aarch64-unknown-linux-gnu/release/{productName}"]
      },
      "mac": {
        "dir": "mac",
        "patterns": ["src-tauri/target/x86_64-apple-darwin/release/bundle/macos/*.app"]
      },
      "mac-arm64": {
        "dir": "mac-arm64",
        "patterns": ["src-tauri/target/aarch64-apple-darwin/release/bundle/macos/*.app"]
      },
      "mac-universal": {
        "dir": "mac-universal",
        "patterns": ["src-tauri/target/universal-apple-darwin/release/bundle/macos/*.app"]
      },
      "android": {
        "dir": "android",
        "patterns": [
          "src-tauri/gen/android/app/build/outputs/apk/**/*.apk",
          "src-tauri/gen/android/app/build/outputs/bundle/**/*.aab"
        ]
      },
      "ios": {
        "dir": "ios",
        "patterns": ["src-tauri/gen/apple/build/**/*.app"]
      },
      "web": {
        "dir": "web",
        "patterns": ["{frontendDist}"]
      }
    }
  },
  "commands": {
    "platforms": ["desktop", "mac", "mac-arm64", "mac-universal", "win", "win-arm64", "win-portable", "win-arm64-portable", "linux", "linux-arm64", "android", "ios", "web", "desktop-platforms", "mobile", "all"],
    "iconPlatforms": ["desktop", "mac", "win", "linux", "android", "ios"],
    "build": {
      "desktop": ["collect:desktop"],
      "mac": ["collect:mac"],
      "mac-arm64": ["collect:mac-arm64"],
      "mac-universal": ["collect:mac-universal"],
      "win": ["collect:win"],
      "win-arm64": ["collect:win-arm64"],
      "win-portable": ["collect:win-portable"],
      "win-arm64-portable": ["collect:win-arm64-portable"],
      "linux": ["collect:linux"],
      "linux-arm64": ["collect:linux-arm64"],
      "android": ["collect:android"],
      "ios": ["collect:ios"],
      "web": ["collect:web"],
      "desktop-platforms": ["collect:desktop"],
      "mobile": ["collect:mobile"],
      "all": ["collect:all"]
    },
    "buildQuick": {
      "desktop": ["build-quick:desktop"],
      "mac": ["build-quick:mac"],
      "mac-arm64": ["build-quick:mac-arm64"],
      "mac-universal": ["build-quick:mac-universal"],
      "win": ["build-quick:win"],
      "win-arm64": ["build-quick:win-arm64"],
      "win-portable": ["build-quick:win-portable"],
      "win-arm64-portable": ["build-quick:win-arm64-portable"],
      "linux": ["build-quick:linux"],
      "linux-arm64": ["build-quick:linux-arm64"],
      "android": ["build-quick:android"],
      "ios": ["build-quick:ios"],
      "web": ["build-quick:web"]
    },
    "ship": {
      "desktop": ["test", "collect:desktop"],
      "mac": ["test", "collect:mac"],
      "mac-arm64": ["test", "collect:mac-arm64"],
      "mac-universal": ["test", "collect:mac-universal"],
      "win": ["test", "collect:win"],
      "win-arm64": ["test", "collect:win-arm64"],
      "win-portable": ["test", "collect:win-portable"],
      "win-arm64-portable": ["test", "collect:win-arm64-portable"],
      "linux": ["test", "collect:linux"],
      "linux-arm64": ["test", "collect:linux-arm64"],
      "android": ["test", "collect:android"],
      "ios": ["test", "collect:ios"],
      "web": ["test", "collect:web"],
      "desktop-platforms": ["test", "collect:desktop"],
      "mobile": ["test", "collect:mobile"],
      "all": ["test", "collect:all"]
    },
    "devSetup": {
      "desktop": ["icon:desktop"],
      "mac": ["icon:mac"],
      "win": ["icon:win"],
      "linux": ["icon:linux"],
      "android": ["icon:android"],
      "ios": ["icon:ios"]
    },
    "devCmd": {
      "desktop": "dev",
      "mac": "dev",
      "win": "dev",
      "linux": "dev",
      "android": "android dev",
      "ios": "ios dev"
    }
  },
  "tasks": {}
}
